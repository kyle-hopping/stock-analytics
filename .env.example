# Alpha Vantage — get key at https://www.alphavantage.co/
ALPHA_VANTAGE_KEY=YOUR_KEY_HERE

# Massive (Polygon.io) — get key at https://massive.com/
MASSIVE_API_KEY=YOUR_KEY_HERE

# InfluxDB — get token from your InfluxDB Cloud dashboard
INFLUXDB_TOKEN=YOUR_TOKEN_HERE
INFLUXDB_URL=YOUR_CLUSTER_URL_HERE
INFLUXDB_ORG=YOUR_ORG_HERE
INFLUXDB_BUCKET=stock_data

# Kafka — default local Docker setup
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_RAW=raw_ticks
KAFKA_TOPIC_PROCESSED=processed_ticks