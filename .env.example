# Alpha Vantage
ALPHA_VANTAGE_KEY=YOUR_REAL_KEY_HERE

# Massive (Polygon.io)
MASSIVE_API_KEY=YOUR_REAL_KEY_HERE

# Grafana
GRAFANA_PASSWORD=your_strong_password_here

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_RAW=raw_ticks
KAFKA_TOPIC_PROCESSED=processed_ticks

# InfluxDB Cloud
INFLUXDB_CLOUD_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_CLOUD_TOKEN=YOUR_REAL_TOKEN_HERE
INFLUXDB_CLOUD_ORG=YOUR_ORG_NAME_HERE
INFLUXDB_CLOUD_BUCKET=stock_data

# InfluxDB Local Dev
# INFLUXDB_TOKEN can stay as "local-dev-token" — Docker sets it on init
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=local-dev-token
INFLUXDB_ORG=stock_analytics
INFLUXDB_BUCKET=stock_data
INFLUXDB_PASSWORD=YOUR_STRONG_PASSWORD_HERE